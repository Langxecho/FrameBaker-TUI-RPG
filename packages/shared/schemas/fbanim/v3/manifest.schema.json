{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framebaker:schema:fbanim:manifest:3",
  "type": "object",
  "required": ["format", "version", "createdBy", "requirements", "entry"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fbanim" },
    "version": { "const": 3 },
    "createdBy": { "$ref": "#/$defs/tool" },
    "requirements": { "$ref": "#/$defs/requirements" },
    "entry": {
      "type": "object",
      "required": ["skeleton", "characterBinding", "bodyProfiles", "equipment", "actions", "actionProfiles", "constraints", "textures"],
      "additionalProperties": false,
      "properties": {
        "skeleton": { "type": "object", "allOf": [{ "$ref": "#/$defs/jsonFile" }, { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "pattern": "^skeletons/" } } }], "unevaluatedProperties": false },
        "characterBinding": { "type": "object", "allOf": [{ "$ref": "#/$defs/jsonFile" }, { "type": "object", "required": ["id", "dependencies"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "pattern": "^bindings/" }, "dependencies": { "$ref": "#/$defs/skeletonDependency" } } }], "unevaluatedProperties": false },
        "bodyProfiles": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/namedJsonFile" } },
        "equipment": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/namedJsonFile" } },
        "actions": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/action" } },
        "actionProfiles": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/namedJsonFile" } },
        "constraints": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/namedJsonFile" } },
        "textures": { "type": "array", "maxItems": 1021, "items": { "$ref": "#/$defs/texture" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tool": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "jsonFile": { "type": "object", "required": ["path", "digest", "byteLength"], "properties": { "path": { "type": "string", "pattern": "^(skeletons|bindings|body-profiles|equipment|motions|action-profiles|constraints)/[a-f0-9]{64}\\.json$", "maxLength": 160 }, "digest": { "$ref": "#/$defs/digest" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 } } },
    "namedJsonFile": { "type": "object", "allOf": [{ "$ref": "#/$defs/jsonFile" }, { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" } } }], "unevaluatedProperties": false },
    "skeletonDependency": { "type": "object", "required": ["skeletonId"], "properties": { "skeletonId": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionRendering": { "type": "integer", "minimum": 1 },
        "equipmentAssembly": { "type": "integer", "minimum": 1 },
        "motionEvents": { "type": "integer", "minimum": 1 },
        "twoBoneIk": { "type": "integer", "minimum": 1 },
        "runtimeWarp": { "type": "integer", "minimum": 1 },
        "meshSkinning": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/jsonFile" },
        {
          "type": "object",
          "required": ["id", "name", "motionClipId", "speed", "repeat", "loop", "dependencies"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "type": "string", "minLength": 1 },
            "motionClipId": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "pattern": "^motions/" },
            "speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
            "repeat": { "type": "integer", "minimum": 1, "maximum": 100 },
            "loop": { "type": "boolean" },
            "dependencies": { "$ref": "#/$defs/skeletonDependency" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "texture": {
      "type": "object",
      "required": ["attachmentId", "path", "digest", "byteLength"],
      "properties": {
        "attachmentId": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^textures/[a-f0-9]{64}\\.png$", "maxLength": 160 },
        "digest": { "$ref": "#/$defs/digest" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      },
      "additionalProperties": false
    }
  }
}
