{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framebaker:schema:animation:v3:common",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
    "transform": {
      "type": "object", "required": ["translation", "rotation", "scale"], "additionalProperties": false,
      "properties": {
        "translation": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false },
        "rotation": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false },
        "scale": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false }
      }
    },
    "tags": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  }
}
