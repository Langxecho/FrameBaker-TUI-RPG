{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:framebaker:schema:animation:v3:action-profile",
  "type": "object", "additionalProperties": false, "required": ["id", "loop", "requiredTracks", "requiredEvents", "allowedEvents", "contactRules", "constraintRules", "defaultInterrupt", "defaultBlendMs"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" }, "loop": { "type": "boolean" }, "requiredTracks": { "$ref": "common.schema.json#/$defs/tags" }, "requiredEvents": { "$ref": "common.schema.json#/$defs/tags" }, "allowedEvents": { "$ref": "common.schema.json#/$defs/tags" }, "constraintRules": { "$ref": "common.schema.json#/$defs/tags" }, "fallbackAction": { "$ref": "common.schema.json#/$defs/id" }, "defaultInterrupt": { "enum": ["immediate", "event-boundary", "non-interruptible"] }, "defaultBlendMs": { "type": "number", "minimum": 0, "maximum": 60000 },
    "contactRules": { "type": "array", "maxItems": 4096, "items": { "type": "object", "additionalProperties": false, "required": ["semantic", "requiredFrom", "requiredUntil", "tolerancePixels"], "properties": { "semantic": { "type": "string", "minLength": 1, "maxLength": 128 }, "requiredFrom": { "type": "number", "minimum": 0, "maximum": 1 }, "requiredUntil": { "type": "number", "minimum": 0, "maximum": 1 }, "tolerancePixels": { "type": "number", "minimum": 0, "maximum": 1024 } } } }
  }
}
