{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:framebaker:schema:animation:v3:equipment",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "name", "tags", "visualMode", "primarySlot", "occupiedSlots", "conflictTags", "replacesParts", "hidesSlots", "attachments"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "$ref": "common.schema.json#/$defs/name" }, "tags": { "$ref": "common.schema.json#/$defs/tags" }, "visualMode": { "enum": ["none", "attached", "replacement", "effect"] }, "primarySlot": { "$ref": "common.schema.json#/$defs/id" }, "occupiedSlots": { "$ref": "common.schema.json#/$defs/tags" }, "conflictTags": { "$ref": "common.schema.json#/$defs/tags" }, "replacesParts": { "$ref": "common.schema.json#/$defs/tags" }, "hidesSlots": { "$ref": "common.schema.json#/$defs/tags" },
    "attachments": { "type": "array", "maxItems": 4096, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "socket", "materialId", "imageSlot", "size", "pivot", "rest", "drawGroup", "drawOffset"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "$ref": "common.schema.json#/$defs/name" }, "socket": { "$ref": "common.schema.json#/$defs/id" }, "materialId": { "$ref": "common.schema.json#/$defs/id" }, "imageSlot": { "enum": ["raw", "processed"] }, "size": { "type": "array", "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "items": false }, "pivot": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "items": false }, "rest": { "$ref": "common.schema.json#/$defs/transform" }, "drawGroup": { "type": "string", "minLength": 1, "maxLength": 128 }, "drawOffset": { "type": "integer" } } } },
    "actionProfile": { "$ref": "common.schema.json#/$defs/id" }, "actionOverrides": { "type": "object", "maxProperties": 512, "additionalProperties": { "$ref": "common.schema.json#/$defs/id" } }, "effectBindings": { "type": "array", "maxItems": 512, "items": { "type": "object", "additionalProperties": false, "required": ["event", "effectId"], "properties": { "event": { "type": "string", "minLength": 1, "maxLength": 128 }, "effectId": { "$ref": "common.schema.json#/$defs/id" }, "socket": { "$ref": "common.schema.json#/$defs/id" }, "enabledState": { "type": "string", "maxLength": 128 } } } },
    "weapon": { "$ref": "#/$defs/weapon" }
  },
  "$defs": {
    "weapon": { "type": "object", "additionalProperties": false, "required": ["holdMode", "preferredPrimaryHand", "mirrorAllowed", "primaryGrip", "stanceProfile"], "properties": { "holdMode": { "enum": ["one_hand", "two_hand", "either"] }, "preferredPrimaryHand": { "enum": ["left", "right"] }, "mirrorAllowed": { "type": "boolean" }, "primaryGrip": { "$ref": "common.schema.json#/$defs/transform" }, "secondaryGrip": { "$ref": "common.schema.json#/$defs/transform" }, "muzzleSocket": { "$ref": "common.schema.json#/$defs/transform" }, "ejectSocket": { "$ref": "common.schema.json#/$defs/transform" }, "stanceProfile": { "$ref": "common.schema.json#/$defs/id" }, "recoilProfile": { "$ref": "common.schema.json#/$defs/id" }, "secondaryHandConstraint": { "$ref": "#/$defs/ik" } } },
    "ik": { "type": "object", "additionalProperties": false, "required": ["id", "upperBoneId", "lowerBoneId", "endBoneId", "targetSocket", "bendDirection", "mix", "stretch"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "upperBoneId": { "$ref": "common.schema.json#/$defs/id" }, "lowerBoneId": { "$ref": "common.schema.json#/$defs/id" }, "endBoneId": { "$ref": "common.schema.json#/$defs/id" }, "targetSocket": { "$ref": "common.schema.json#/$defs/id" }, "bendDirection": { "enum": ["positive", "negative"] }, "mix": { "type": "number", "minimum": 0, "maximum": 1 }, "stretch": { "enum": ["forbid", "limited"] }, "maxStretch": { "type": "number", "minimum": 1 } } }
  }
}
