{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-idle-rpg.local/contracts/framebaker-monster-sprite-extract-v1.schema.json",
  "title": "R1 frozen: FrameBaker monster sprite extract v1",
  "$comment": "Frozen Boundary A source-material contract. This is not a runtime or .monster package contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "source",
    "displayName",
    "canvas",
    "coordinateSystem",
    "objectOriginPx",
    "defaultFacing",
    "actions"
  ],
  "properties": {
    "format": { "const": "framebaker.monster-sprite-extract" },
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "exportId", "toolName", "toolVersion", "exportedAt"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "exportId": { "$ref": "#/$defs/id" },
        "toolName": { "const": "FrameBaker" },
        "toolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "exportedAt": { "type": "string", "format": "date-time" }
      }
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "xAxis", "yAxis", "origin", "mirrorAxis"],
      "properties": {
        "space": { "const": "pixel_2d" },
        "xAxis": { "const": "right" },
        "yAxis": { "const": "down" },
        "origin": { "const": "top_left" },
        "mirrorAxis": { "const": "x" }
      }
    },
    "objectOriginPx": { "$ref": "#/$defs/point" },
    "defaultFacing": { "enum": ["left", "right"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 2048 },
        "y": { "type": "number", "minimum": 0, "maximum": 2048 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number", "minimum": 0, "maximum": 2048 },
        "y": { "type": "number", "minimum": 0, "maximum": 2048 },
        "directionDegrees": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "startTimeMs", "durationMs", "sha256", "anchors"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/safePath" },
        "startTimeMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "durationMs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "anchors": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "atMs", "presentationOnly"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^(?!combat\\.hitbox(?:\\.|$))[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "atMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "presentationOnly": { "const": true }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "displayName", "loopMode", "sampleRateHz", "frames", "markers"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "loopMode": { "enum": ["once", "loop", "hold"] },
        "sampleRateHz": { "type": "integer", "minimum": 1, "maximum": 60 },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3600,
          "items": { "$ref": "#/$defs/frame" }
        },
        "markers": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/marker" }
        }
      }
    }
  }
}
